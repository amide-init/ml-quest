{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["react", "typescript", "oxc", "unicorn", "import"],
  "categories": {
    "correctness": "error",
    "suspicious": "warn"
  },
  "env": {
    "browser": true,
    "es2024": true
  },
  "ignorePatterns": ["dist", "coverage", "node_modules"],
  "rules": {
    "eqeqeq": ["error", "always"],
    "no-console": ["warn", { "allow": ["warn", "error", "info"] }],
    "no-debugger": "error",
    "no-unused-vars": ["error", { "argsIgnorePattern": "^_", "varsIgnorePattern": "^_" }],
    "no-restricted-imports": [
      "error",
      {
        "patterns": [
          {
            "group": ["../*", "../../*", "../../../*"],
            "message": "Use the @/ alias for imports outside the current folder (RULES.md §4)."
          }
        ]
      }
    ],

    "typescript/no-explicit-any": "error",
    "typescript/ban-ts-comment": ["error", { "ts-expect-error": "allow-with-description" }],
    "typescript/consistent-type-imports": "error",

    "react/react-in-jsx-scope": "off",
    "react/rules-of-hooks": "error",
    "react/exhaustive-deps": "error",
    "react/jsx-key": "error",
    "react/no-array-index-key": "warn",
    "react/only-export-components": ["warn", { "allowConstantExport": true }],

    "import/no-cycle": "error",
    "import/no-default-export": "error",
    "import/no-unassigned-import": ["error", { "allow": ["**/*.css"] }]
  },
  "overrides": [
    {
      "files": ["src/engine/**", "src/services/**"],
      "rules": {
        "typescript/no-non-null-assertion": "error"
      }
    },
    {
      "files": ["src/**/index.ts"],
      "rules": {
        "unicorn/no-empty-file": "off"
      }
    },
    {
      "files": ["*.config.ts", "*.config.js", "*.cjs"],
      "rules": {
        "import/no-default-export": "off"
      }
    }
  ]
}
