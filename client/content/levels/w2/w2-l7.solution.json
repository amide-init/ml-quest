      "commands": [
        {
          "type": "set-hyperparameter",
          "name": "threshold",
          "value": 0.1
        },
        {
          "type": "check"
        },
        {
          "type": "retry"
        },
        {
          "type": "set-hyperparameter",
          "name": "threshold",
          "value": 0.45
        },
        {
          "type": "check"
        },
        {
          "type": "retry"
        },
        {
          "type": "set-hyperparameter",
          "name": "threshold",
          "value": 0.35
        },
        {
          "type": "check"
        }
      ]
    },
    {
      "name": "anti-solution (the trap): the default 0.5 misses a third of the hill folk",
      "expect": {
        "passed": false
      },
      "commands": [
        {
          "type": "check"
        }
      ]
    },
    {
      "name": "anti-solution: invite nearly everyone, and precision collapses",
      "expect": {
        "passed": false
